PUID=1026
PGID=100
TZ=Etc/UTC

# Use 127.0.0.1 with Synology Reverse Proxy. Use 0.0.0.0 for direct LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
DATA_PATH=./data

SCAN_PATHS=/movies,/tv
EXCLUDE_PATHS=/movies/@eaDir,/tv/@eaDir
CRON_SCHEDULE=0 0 * * *
MAX_CONCURRENT_SYNC_TASKS=1
INCLUDE_ENGINES=ffsubsync,autosubsync,alass
OVERWRITE_ORIGINAL=false

# Optional AI translation:
# INCLUDE_ENGINES=ffsubsync,autosubsync,alass,ai-translate
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# AI_REQUIRED_SUBTITLE_LANGUAGES=zh-TW,zh-CN,chi

# Optional Telegram notifications:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
