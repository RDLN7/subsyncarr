{
  "name": "@johnpc/subsyncarr-plus",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf dist; rm -rf node_modules; rm -rf build/* && rm -rf build",
    "build": "tsc",
    "start": "node dist/index-server.js",
    "start:legacy": "node dist/index.js",
    "watch": "tsc -w",
    "lint": "eslint .",
    "lint:fix": "prettier --write \"**/*\" && npm run lint -- --fix",
    "format:check": "prettier --check .",
    "test": "jest",
    "deploy:synology": "bash deploy-to-synology.sh",
    "prepare": "husky || true"
  },
  "main": "./dist/index-server.js",
  "exports": "./dist/index-server.js",
  "files": [
    "dist/",
    "!**/__tests__/**"
  ],
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tsconfig/node18": "^18.2.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "babel-jest": "^30.4.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-mock": "^30.4.1",
    "lint-staged": "^17.0.5",
    "prettier": "3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.json": "prettier --write",
    "*.yml": "prettier --write",
    "*.md": "prettier --write"
  }
}
